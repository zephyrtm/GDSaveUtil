<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="GeometryDashSaveMerger.MainWindow"
        Title="Geometry Dash Save Merger"
        Width="600" Height="500"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    
    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Background" Value="#2D2D30"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#1C97EA"/>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#0062A3"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#565656"/>
        </Style>
        <Style Selector="Border#PreviewBorder">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#565656"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Window.Styles>

    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <!-- File Selection Section -->
        <TextBlock Grid.Row="0" Text="First Save File:" Margin="0,0,0,5"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,15">
            <TextBox x:Name="TxtFile1" IsReadOnly="True" Width="300"/>
            <Button x:Name="BtnSelectFile1" Content="Select File 1" Click="OnSelectFile1Click"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Second Save File:" Margin="0,0,0,5"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,0,0,15">
            <TextBox x:Name="TxtFile2" IsReadOnly="True" Width="300"/>
            <Button x:Name="BtnSelectFile2" Content="Select File 2" Click="OnSelectFile2Click"/>
        </StackPanel>

        <!-- Preview Section -->
        <Border Grid.Row="4" Margin="0,0,0,15" 
                BorderThickness="1" BorderBrush="#565656" CornerRadius="4"
                Background="#2D2D30">
            <StackPanel Spacing="10" Margin="15">
                <TextBlock Text="File Previews" FontWeight="Bold" FontSize="14"/>
                
                <TextBlock Text="File 1 Preview:" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtPreview1" IsReadOnly="True" AcceptsReturn="True" 
                         TextWrapping="Wrap" Height="60"/>
                
                <TextBlock Text="File 2 Preview:" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBox x:Name="TxtPreview2" IsReadOnly="True" AcceptsReturn="True" 
                         TextWrapping="Wrap" Height="60"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="10">
            <Button x:Name="BtnMerge" Content="Merge Files" Click="OnMergeClick" Width="120" Height="35"/>
            <Button x:Name="BtnDecryptOnly" Content="Decrypt Only" Click="OnDecryptOnlyClick" Width="120" Height="35"/>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="6" x:Name="LblStatus" Text="Select two .dat files to begin..." 
                   Margin="0,15,0,0" VerticalAlignment="Center"/>
    </Grid>
</Window>